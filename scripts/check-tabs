#!/usr/bin/env python3
"""Verify custom tab actions using disposable native windows and notes."""
import json
import os
from pathlib import Path
import subprocess
import sys
import time
ROOT=Path(__file__).resolve().parent.parent
sys.path.insert(0,str(ROOT))
from core.session import environment,hypr,dispatch

evidence=ROOT/'.test-output'/('tabs-'+str(int(time.time())));evidence.mkdir(parents=True)
for name,path in {'Commons':Path('/usr/share/omarchy/shell/Commons'),'Ui':Path('/usr/share/omarchy/shell/Ui'),'Notes':ROOT}.items(): (evidence/name).symlink_to(path)
(evidence/'shell.qml').write_text((ROOT/'tests/native/shell.qml').read_text())
env=environment();env.update(PANEL_NOTES_ROOT=str(evidence/'collection'),PANEL_NOTES_RECOVERY=str(evidence/'recovery'))
original=hypr('activeworkspace')['id'];active=hypr('activewindow').get('address')
process=None;results=[]
def ipc(method,*args):
 r=subprocess.run(['qs','ipc','-p',str(evidence),'call','test',method,*args],env=env,capture_output=True,text=True,check=True,timeout=5)
 return r.stdout.strip()
def state():return json.loads(ipc('state'))
def wait(fn,message):
 until=time.monotonic()+8
 while time.monotonic()<until:
  try:
   v=fn()
   if v:return v
  except (ValueError,subprocess.SubprocessError):pass
  time.sleep(.1)
 raise AssertionError(message)
def check(value,message):
 assert value,message
 results.append(message);print('PASS '+message,flush=True)
try:
 dispatch('focus',workspace='name:panel-notes-tabs-'+str(os.getpid()))
 log=(evidence/'native.log').open('w')
 process=subprocess.Popen(['qs','-p',str(evidence),'--no-color'],env=env,stdout=log,stderr=log)
 def source():return next((w for w in hypr('clients') if w['pid']==process.pid and w['title']=='Panel Notes native source'),None)
 w=wait(source,'Source absent');address=w['address']
 dispatch('window.float',action='on',window='address:'+address)
 dispatch('window.resize',x=1050,y=750,relative=False,window='address:'+address)
 dispatch('focus',window='address:'+address)
 ipc('open',address);wait(lambda:state()['panel']['opened'] and state()['panel']['noteId'],'Panel absent')
 def tabs():return json.loads(ipc('tabs'))
 def key(*args):
  assert hypr('activewindow').get('address')==address, 'Focus changed; stopping test input'
  subprocess.run(['wtype',*args],env=env,check=True)
 def capture(name):
  w=source();time.sleep(.2)
  subprocess.run(['grim','-g',f"{w['at'][0]},{w['at'][1]} {w['size'][0]}x{w['size'][1]}",str(evidence/name)],env=env,check=True)
 time.sleep(.3)
 key('-M','ctrl','-k','t','-m','ctrl')
 wait(lambda:tabs()['dialog'] and tabs()['focus'],'Ctrl+T did not open focused dialog')
 capture('add-tab.png')
 key('-k','Escape');wait(lambda:not tabs()['dialog'],'Escape did not dismiss dialog')
 check(state()['panel']['opened'],'Escape cancels Add tab while keeping the notes panel open')
 ipc('showAddTab');ipc('addTab','not a path')
 wait(lambda:tabs()['error'],'Invalid path did not show error')
 check(tabs()['dialog'] and len(tabs()['scopes'])==1,'Invalid input stays in dialog and does not create a tab')
 ipc('addTab','https://example.com/first')
 wait(lambda:not tabs()['dialog'] and len(tabs()['scopes'])==2,'First tab absent')
 ipc('edit','A thought to retain after removal.');wait(lambda:state()['panel']['status']=='Saved','Save not complete')
 note_id=state()['panel']['noteId']
 ipc('showAddTab')
 # Enter submits the dialog through its actual keyboard path.
 key('https://example.com/second');key('-k','Return')
 wait(lambda:not tabs()['dialog'] and len(tabs()['scopes'])==3,'Second tab absent')
 wait(lambda:state()['text']=='' and state()['editorText']=='','Second tab did not show its own empty note')
 check(tabs()['scopes'][-1]['label']=='example.com/second','Enter adds a second named URL tab without replacing the first')
 capture('tabs.png')
 key('-M','alt','-k','2','-m','alt');wait(lambda:state()['panel']['noteId']==note_id,'Alt+2 did not select first resource')
 key('-M','ctrl','-M','shift','-k','Delete','-m','shift','-m','ctrl')
 wait(lambda:len(tabs()['scopes'])==2 and tabs()['selected']==0,'Remove shortcut failed')
 saved=next((evidence/'collection/notes').glob('*--'+note_id+'/notes.md'))
 check(saved.read_text()=='A thought to retain after removal.','Remove tab returns to App and retains the note on disk')
 ipc('showAddTab');ipc('addTab','https://example.com/first')
 wait(lambda:state()['panel']['noteId']==note_id and not tabs()['dialog'],'Re-add did not recover note')
 check(state()['text']=='A thought to retain after removal.','Re-adding a resource restores its existing notes')
 dispatch('window.resize',x=400,y=580,relative=False,window='address:'+address)
 wait(lambda:not state()['panel']['opened'],'Resize did not hide')
 ipc('open',address);wait(lambda:state()['panel']['opened'],'Narrow panel absent')
 ipc('showAddTab');wait(lambda:tabs()['dialog'],'Narrow dialog absent');capture('add-tab-narrow.png')
 key('-k','Escape');ipc('settings');capture('settings.png')
 check('Context setup guide' not in state()['panel']['actions'],'Settings no longer contains the resource setup guide')
finally:
 if process:
  process.terminate()
  try:process.wait(timeout=4)
  except subprocess.TimeoutExpired:process.kill();process.wait()
 subprocess.run([str(ROOT/'panel-notes'),'shutdown'],env=env,capture_output=True)
 dispatch('focus',workspace=str(original))
 if active:dispatch('focus',window='address:'+active)
 for name in ('Commons','Ui','Notes'):(evidence/name).unlink(missing_ok=True)
 (evidence/'results.json').write_text(json.dumps({'passed':results},indent=2))
 print('Evidence: '+str(evidence))
