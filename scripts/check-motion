#!/usr/bin/env python3
"""Verify depth transitions and dismissal input release in a disposable native shell."""
import json
import os
from pathlib import Path
import subprocess
import sys
import time
ROOT=Path(__file__).resolve().parent.parent
sys.path.insert(0,str(ROOT))
from core.session import environment,hypr,dispatch

evidence=ROOT/'.test-output'/('motion-'+str(int(time.time())));evidence.mkdir(parents=True)
for name,path in {'Commons':Path('/usr/share/omarchy/shell/Commons'),'Ui':Path('/usr/share/omarchy/shell/Ui'),'Notes':ROOT}.items(): (evidence/name).symlink_to(path)
(evidence/'shell.qml').write_text((ROOT/'tests/native/shell.qml').read_text())
env=environment();env.update(PANEL_NOTES_ROOT=str(evidence/'collection'),PANEL_NOTES_RECOVERY=str(evidence/'recovery'))
original=hypr('activeworkspace')['id'];active=hypr('activewindow').get('address')
process=None;results=[]
def ipc(method,*args):
 r=subprocess.run(['qs','ipc','-p',str(evidence),'call','test',method,*args],env=env,capture_output=True,text=True,check=True,timeout=5)
 return r.stdout.strip()
def state():return json.loads(ipc('state'))
def wait(fn,message):
 until=time.monotonic()+8
 while time.monotonic()<until:
  try:
   v=fn()
   if v:return v
  except (ValueError,subprocess.SubprocessError):pass
  time.sleep(.1)
 raise AssertionError(message)
def check(value,message):
 assert value,message
 results.append(message);print('PASS '+message,flush=True)
try:
 dispatch('focus',workspace='name:panel-notes-motion-'+str(os.getpid()))
 log=(evidence/'native.log').open('w')
 process=subprocess.Popen(['qs','-p',str(evidence),'--no-color'],env=env,stdout=log,stderr=log)
 def source():return next((w for w in hypr('clients') if w['pid']==process.pid and w['title']=='Panel Notes native source'),None)
 w=wait(source,'Source absent');address=w['address']
 dispatch('window.float',action='on',window='address:'+address)
 dispatch('window.resize',x=1000,y=750,relative=False,window='address:'+address)
 dispatch('focus',window='address:'+address)
 def motion():return json.loads(ipc('motion'))
 def open_panel():
  ipc('resetMotion');ipc('open',address)
  wait(lambda:motion()['current']['reveal']==1 and state()['panel']['noteId'],'Entrance did not finish')
 def key(*args):
  assert hypr('activewindow').get('address')==address, 'Focus changed; stopping test input'
  subprocess.run(['wtype',*args],env=env,check=True)
 open_panel()
 entering=motion()['samples']
 check(any(0<s['reveal']<1 and s['visible'] for s in entering),'Entrance renders intermediate fade/scale progress before settling')
 ipc('edit','Depth transition fixture.');wait(lambda:state()['panel']['status']=='Saved','Save not complete')
 ipc('dismiss')
 initial=motion()['current']
 check(initial['closing'] and initial['visible'] and not initial['opened'] and initial['masked'] and initial['keyboard']==0,'Dismissal keeps a visible exit frame but immediately releases pointer and keyboard input')
 key('Input after dismiss')
 wait(lambda:not motion()['current']['visible'],'Exit did not unmap')
 exiting=motion()['samples']
 check(any(0<s['reveal']<1 and s['closing'] and s['visible'] for s in exiting),'Exit renders intermediate fade/scale progress before unmapping')
 check('Input after dismiss' in state()['sourceText'] and state()['text']=='Depth transition fixture.','Typing immediately after dismissal reaches the source and leaves notes unchanged')
 (evidence/'motion.json').write_text(json.dumps({'enter':entering,'exit':exiting},indent=2))
 # Interrupt an exit with a new opening; no stale timer may hide it later.
 open_panel();ipc('dismiss');ipc('open',address)
 wait(lambda:motion()['current']['reveal']==1 and motion()['current']['opened'],'Interrupted exit failed to reopen')
 time.sleep(.25)
 check(motion()['current']['visible'] and not motion()['current']['closing'],'Rapid reopening cancels the old exit')
 # Immediate close is the lifecycle path used by source geometry changes.
 ipc('close')
 check(not motion()['current']['visible'] and not motion()['current']['closing'],'Lifecycle close bypasses exit animation')
 open_panel()
 dispatch('window.resize',x=900,y=700,relative=False,window='address:'+address)
 wait(lambda:not motion()['current']['visible'],'Resize left overlay visible')
 check(not motion()['current']['closing'],'Source resize hides the panel without an exit animation')
 ipc('reduce');open_panel();ipc('dismiss');wait(lambda:not motion()['current']['visible'],'Reduced motion exit failed')
 check(True,'Existing reduced-motion preference remains compatible')
finally:
 if process:
  try:(evidence/'final-state.json').write_text(json.dumps(state(),indent=2))
  except Exception:pass
  process.terminate()
  try:process.wait(timeout=4)
  except subprocess.TimeoutExpired:process.kill();process.wait()
 subprocess.run([str(ROOT/'panel-notes'),'shutdown'],env=env,capture_output=True)
 dispatch('focus',workspace=str(original))
 if active:dispatch('focus',window='address:'+active)
 for name in ('Commons','Ui','Notes'):(evidence/name).unlink(missing_ok=True)
 (evidence/'results.json').write_text(json.dumps({'passed':results},indent=2))
 print('Evidence: '+str(evidence))
