#!/usr/bin/env python3
"""Remove the installed plugin; preserve notes, recovery, and this checkout."""
from pathlib import Path
import subprocess
import json
import time
import sys
sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))
from core.session import environment
from core.backend import PLUGIN_ID
env = environment()
target = Path.home() / '.config/omarchy/plugins' / PLUGIN_ID
from core.setup import remove_shortcut
if target.exists():
    catalog = subprocess.run(['omarchy', 'plugin', 'list', '--json'], env=env, check=True, capture_output=True, text=True)
    enabled = any(item.get('id') == PLUGIN_ID and item.get('enabled') for item in json.loads(catalog.stdout))
    if enabled:
        subprocess.run([str(target / 'panel-notes'), 'hide'], env=env, check=True)
        for attempt in range(30):
            result = subprocess.run(['omarchy-shell', 'shell', 'call', PLUGIN_ID, 'inspect', ''], env=env, check=True, capture_output=True, text=True)
            try:
                state = json.loads(result.stdout)
                if isinstance(state, dict) and (not state.get('noteId') or (state.get('pendingSaves', 0) == 0 and state.get('status') == 'Saved')): break
            except ValueError: pass
            time.sleep(.1)
        else:
            raise SystemExit('Removal stopped: resolve the note save status before trying again.')
    remove_shortcut()
    subprocess.run([str(target / 'panel-notes'), 'shutdown'], env=env, check=True)
    subprocess.run(['omarchy', 'plugin', 'remove', PLUGIN_ID, '--yes'], env=env, check=True)
else:
    remove_shortcut()
print('Removed Panel Notes. Your notes and recovery drafts were retained.')
