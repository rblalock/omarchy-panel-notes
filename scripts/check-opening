#!/usr/bin/env python3
"""Measure native IPC invocation to first submitted nontransparent frame; isolated collection."""
import json
import os
from pathlib import Path
import subprocess
import sys
import time
ROOT=Path(__file__).resolve().parent.parent
sys.path.insert(0,str(ROOT))
from core.session import environment,hypr,dispatch

evidence=ROOT/'.test-output'/('opening-'+str(int(time.time())));evidence.mkdir(parents=True)
for name,path in {'Commons':Path('/usr/share/omarchy/shell/Commons'),'Ui':Path('/usr/share/omarchy/shell/Ui'),'Notes':ROOT}.items(): (evidence/name).symlink_to(path)
(evidence/'shell.qml').write_text((ROOT/'tests/native/shell.qml').read_text())
env=environment();env.update(PANEL_NOTES_ROOT=str(evidence/'collection'),PANEL_NOTES_RECOVERY=str(evidence/'recovery'))
original=hypr('activeworkspace')['id'];active=hypr('activewindow').get('address')
process=None;results=[]
def ipc(method,*args):
 r=subprocess.run(['qs','ipc','-p',str(evidence),'call','test',method,*args],env=env,capture_output=True,text=True,check=True,timeout=5)
 return r.stdout.strip()
def state():return json.loads(ipc('state'))
def wait(fn,message):
 until=time.monotonic()+8
 while time.monotonic()<until:
  try:
   v=fn()
   if v:return v
  except (ValueError,subprocess.SubprocessError):pass
  time.sleep(.1)
 raise AssertionError(message)
def check(value,message):
 assert value,message
 results.append(message);print('PASS '+message,flush=True)
try:
 dispatch('focus',workspace='name:panel-notes-opening-'+str(os.getpid()))
 log=(evidence/'native.log').open('w')
 process=subprocess.Popen(['qs','-p',str(evidence),'--no-color'],env=env,stdout=log,stderr=log)
 def source():return next((w for w in hypr('clients') if w['pid']==process.pid and w['title']=='Panel Notes native source'),None)
 w=wait(source,'Source absent');address=w['address']
 dispatch('window.float',action='on',window='address:'+address)
 dispatch('window.resize',x=1000,y=750,relative=False,window='address:'+address)
 dispatch('focus',window='address:'+address)
 time.sleep(.25)
 def opening():return json.loads(ipc('opening'))
 was_ready=opening()['serviceReady']
 measurements=[]
 for index in range(9):
  ipc('timedOpen',str(time.time_ns()//1000000))
  sample=wait(lambda:opening() if opening()['settled'] else None,'No completed opening frame')
  measurements.append({'firstFrameMs':sample['firstFrame']-sample['started'],'settledMs':sample['settled']-sample['started']})
  ipc('close');time.sleep(.05)
 import statistics
 report={'readyBeforeFirstOpen':was_ready,'firstOpening':measurements[0],
         'warmMedianMs':{key:statistics.median(row[key] for row in measurements[1:]) for key in measurements[0]},
         'measurements':measurements}
 (evidence/'timings.json').write_text(json.dumps(report,indent=2))
 print(json.dumps(report,indent=2))
 check(all(row['settledMs']>row['firstFrameMs'] for row in measurements),'Every opening submits a visible frame before its animation completes')
 ipc('open',address);wait(lambda:state()['panel']['opened'],'Panel absent before restart check')
 ipc('edit','A note survives service restart.');wait(lambda:state()['panel']['status']=='Saved','Save not complete')
 note_id=state()['panel']['noteId'];ipc('close')
 subprocess.run([str(ROOT/'panel-notes'),'shutdown'],env=env,check=True)
 wait(lambda:not opening()['serviceReady'],'Service readiness did not clear after shutdown')
 ipc('timedOpen',str(time.time_ns()//1000000))
 wait(lambda:opening()['settled'] and state()['panel']['status']=='Saved','Opening after service restart failed')
 check(state()['panel']['noteId']==note_id and state()['text']=='A note survives service restart.','An opening after service shutdown reconnects and restores the same saved note')

 for attempt in range(5):
  subprocess.run([str(ROOT/'panel-notes'),'shutdown'],env=env,check=True)
  wait(lambda:state()['panel']['status']=='Connection lost','Disconnect not reported')
  draft='Draft written during service disconnect ' + str(attempt)
  ipc('edit',draft)
  ipc('retrySave')
  wait(lambda:state()['panel']['status']=='Saved' and state()['text']==draft,'Retry after service shutdown failed')
  check(state()['panel']['noteId']==note_id,'Retry reconnects and saves draft ' + str(attempt) + ' to the same note')

finally:
 if process:
  try:(evidence/'final-state.json').write_text(json.dumps(state(),indent=2))
  except Exception:pass
  process.terminate()
  try:process.wait(timeout=4)
  except subprocess.TimeoutExpired:process.kill();process.wait()
 subprocess.run([str(ROOT/'panel-notes'),'shutdown'],env=env,capture_output=True)
 dispatch('focus',workspace=str(original))
 if active:dispatch('focus',window='address:'+active)
 for name in ('Commons','Ui','Notes'):(evidence/name).unlink(missing_ok=True)
 (evidence/'results.json').write_text(json.dumps({'passed':results},indent=2))
 print('Evidence: '+str(evidence))
