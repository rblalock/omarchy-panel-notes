#!/usr/bin/env python3
"""Read live controls and exercise shortcuts without changing storage settings or note text."""
import json
from pathlib import Path
import subprocess
import sys
import time
ROOT=Path(__file__).resolve().parent.parent
sys.path.insert(0,str(ROOT))
from core.session import environment,hypr,dispatch
from core.backend import PLUGIN_ID

env=environment();env['OMARCHY_SHELL_IPC_TIMEOUT']='10s'
evidence=ROOT/'.test-output'/('live-ui-'+str(int(time.time())));evidence.mkdir(parents=True)
original=hypr('activeworkspace')['id'];active=hypr('activewindow').get('address')
process=None;results=[];did_open=False
def run(args):
 return subprocess.run(args,env=env,capture_output=True,text=True,timeout=15,check=True).stdout.strip()
def ipc(method,arg=''):return run(['omarchy-shell','shell','call',PLUGIN_ID,method,arg])
def state():return json.loads(run(['omarchy-shell','panel-notes','inspect']))
def wait(fn,message):
 end=time.monotonic()+8
 while time.monotonic()<end:
  value=fn()
  if value:return value
  time.sleep(.1)
 raise AssertionError(message)
try:
 assert not state()['opened'], 'Close notes before running the live UI check'
 dispatch('focus',workspace='name:panel-notes-ui-'+str(int(time.time())))
 process=subprocess.Popen(['qs','-p',str(ROOT/'tests/native/source.qml')],env=env,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
 source=wait(lambda:next((w for w in hypr('clients') if w['pid']==process.pid),None),'Source absent')
 dispatch('focus',window='address:'+source['address'])
 did_open=True
 run(['omarchy-shell','panel-notes','toggle'])
 wait(lambda:state()['opened'] and state()['noteId'] and state()['source']['address']==source['address'],'Panel absent')
 time.sleep(.3)
 loaded=state()
 assert loaded['interfaceVersion']=='2026-09-09.16'
 assert loaded['loadedPath']==(Path.home()/'.config/omarchy/plugins'/PLUGIN_ID/'Panel.qml').as_uri()
 assert 'Snapshot' in loaded['actions'] and 'Preview' in loaded['actions'] and '?' in loaded['actions'],loaded
 results.append('Public panel-notes command opens the installed plugin with Preview, Snapshot and shortcut help')
 run(['grim','-g',f"{source['at'][0]},{source['at'][1]} {source['size'][0]}x{source['size'][1]}",str(evidence/'panel.png')])
 def key(args,predicate,message):
  assert hypr('activewindow').get('address')==source['address'],'Focus changed; stopping input'
  run(['wtype',*args]);wait(predicate,message);results.append(message)
 key(['-k','F1'],lambda:state()['page']=='shortcuts','F1 opens keyboard shortcut guide')
 run(['grim','-g',f"{source['at'][0]},{source['at'][1]} {source['size'][0]}x{source['size'][1]}",str(evidence/'shortcuts.png')])
 key(['-M','ctrl','-k','comma','-m','ctrl'],lambda:state()['page']=='settings','Ctrl+, opens Settings')
 key(['-M','ctrl','-k','e','-m','ctrl'],lambda:state()['page']=='note','Ctrl+E returns to notes')
 key(['-M','ctrl','-M','shift','-k','p','-m','shift','-m','ctrl'],lambda:state()['preview'],'Ctrl+Shift+P opens preview')
 key(['-M','ctrl','-M','shift','-k','p','-m','shift','-m','ctrl'],lambda:not state()['preview'],'Ctrl+Shift+P returns to editing')
 key(['-k','Escape'],lambda:not state()['opened'],'Escape closes the actual installed panel')
finally:
 if did_open:
  try:run(['omarchy-shell','panel-notes','hide'])
  except Exception:pass
 if process:
  process.terminate()
  try:process.wait(timeout=4)
  except subprocess.TimeoutExpired:process.kill();process.wait()
 dispatch('focus',workspace=str(original))
 if active:dispatch('focus',window='address:'+active)
 (evidence/'results.json').write_text(json.dumps({'passed':results},indent=2))
 for x in results:print('PASS '+x)
 print('Evidence: '+str(evidence))
